rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, create, update, delete: if signedInAs(userId);

      match /{document=**} {
        allow read, create, update, delete: if signedInAs(userId);
      }
    }

    function signedInAs(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
  }
}

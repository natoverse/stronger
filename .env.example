# Google OAuth client ID (from Google Cloud Console → APIs & Services → Credentials)
# Required for gapi to call the Sheets and Calendar APIs.
VITE_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Firebase project configuration (from Firebase Console → Project Settings → General → Your apps)
# Auth is handled by Firebase; the OAuth scopes for Sheets/Calendar are added via GoogleAuthProvider.
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=1:123456789:web:abc123

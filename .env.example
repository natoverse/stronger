# Google OAuth client ID (from Google Cloud Console → APIs & Services → Credentials)
# Required for Google Identity Services to obtain access tokens for the
# Sheets and Calendar APIs.
VITE_GOOGLE_CLIENT_ID=123456789000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Firebase web application configuration. Used only to create and display the
# permanent Firebase Authentication UID before the Firestore migration.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
